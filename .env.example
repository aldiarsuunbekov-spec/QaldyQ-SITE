# Copy this file to .env in the project root for Docker Compose.
# This template contains no secrets. Keep .env out of version control.

# Expose the app only to a reverse proxy on this host by default.
# If the proxy is in another container/network, configure the narrowest required bind.
FOODSAVER_BIND=127.0.0.1
FOODSAVER_PORT=8000

# Public deployment defaults: HTTPS is required for Secure cookies.
QALDYQ_ENV=production
QALDYQ_COOKIE_SECURE=true

# Replace with the exact TLS proxy IP/CIDR as seen by the app container.
# Never set this to * on an internet-facing deployment.
QALDYQ_FORWARDED_ALLOW_IPS=127.0.0.1
